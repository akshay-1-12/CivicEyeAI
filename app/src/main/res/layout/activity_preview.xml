<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:text="Preview Complaint"
            android:textColor="@color/text_dark" android:textSize="22sp" android:textStyle="bold"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:layout_marginTop="4dp"
            android:text="Please review the details before submitting"
            android:textColor="@color/text_muted" android:textSize="13sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:background="@drawable/bg_white_card"
            android:orientation="horizontal" android:padding="14dp">

            <ImageView android:id="@+id/ivThumb" android:layout_width="90dp" android:layout_height="90dp"
                android:background="@drawable/bg_input" android:scaleType="centerCrop"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Issue Type" android:textColor="@color/text_muted" android:textSize="12sp"/>

                <TextView android:id="@+id/tvIssueType" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Pothole" android:textColor="@color/text_dark" android:textSize="16sp" android:textStyle="bold"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:text="Severity" android:textColor="@color/text_muted" android:textSize="12sp"/>

                <TextView android:id="@+id/tvSeverity" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="🔴 High" android:textColor="@color/status_red"
                    android:textSize="14sp" android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Description" android:textColor="@color/text_muted" android:textSize="13sp"/>

        <TextView android:id="@+id/tvDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/text_dark" android:textSize="15sp"
            android:text="Large pothole causing damage to vehicles and risk of accidents."/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Location" android:textColor="@color/text_muted" android:textSize="13sp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <TextView android:id="@+id/tvLocation" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginTop="4dp"
                android:text="MG Road, Amravati, Maharashtra"
                android:textColor="@color/text_dark" android:textSize="15sp"/>

            <TextView android:id="@+id/tvViewMap" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="View on Map" android:textColor="@color/primary" android:textSize="13sp" android:textStyle="bold"/>

        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Department" android:textColor="@color/text_muted" android:textSize="13sp"/>

        <TextView android:id="@+id/tvDepartment" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Municipal Corporation"
            android:textColor="@color/text_dark" android:textSize="15sp"/>

        <Button android:id="@+id/btnSubmit" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="26dp" android:background="@drawable/bg_button_green"
            android:text="Submit Complaint" android:textAllCaps="false"
            android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>